using System;

class Program
{
    static double FutureValue(double currentValue,
                              double growthRate,
                              int years)
    {
        if (years == 0)
            return currentValue;

        return FutureValue(
            currentValue * (1 + growthRate),
            growthRate,
            years - 1
        );
    }

    static void Main()
    {
        double amount = FutureValue(10000, 0.10, 3);

        Console.WriteLine("Future Value = " + amount);
    }
}